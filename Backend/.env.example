# Required to start the backend
MONGO_URI=mongodb://127.0.0.1:27017/swiftmove
JWT_SECRET=
# Generate a unique random secret of at least 32 bytes before starting.
PORT=5000
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# Render staging uses APP_ENV=staging and CORS_ORIGINS=http://localhost:5173,https://swiftmove-staging.vercel.app,https://localhost
# Production uses APP_ENV=production and CORS_ORIGINS=https://swiftmove-movers-and-packers.vercel.app

# Set to the number of trusted reverse-proxy hops in the deployment.
# Use 0 for direct local development. Configure the correct value on Render.
TRUST_PROXY_HOPS=0

# Required for checkout and backend payment verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required for address geocoding and road routing
GEOAPIFY_API_KEY=

# Approved proposed staging transport rates (INR).
PRICING_CURRENCY=INR
PRICING_VEHICLES_JSON={"three_wheeler_eeco":{"baseFare":250,"perKmRate":14,"minimumFare":500},"tata_ace":{"baseFare":300,"perKmRate":18,"minimumFare":700},"pickup_bolero":{"baseFare":800,"perKmRate":25,"minimumFare":1200},"tata_407_14ft":{"baseFare":1500,"perKmRate":32,"minimumFare":2000},"truck_17ft":{"baseFare":3300,"perKmRate":42,"minimumFare":4000},"truck_20_32ft":{"baseFare":5000,"perKmRate":65,"minimumFare":6000}}
# Material rates remain unset until the business defines each quantity's price unit.
# Expected shape only; do not configure null placeholder rates in Render.
# PRICING_PACKING_MATERIAL_RATES_JSON={"cartons":null,"bubbleWrap":null,"stretchFilm":null,"protectiveCovers":null,"tape":null,"other":null}
# Approved proposed staging labour rates, configurable per worker (INR).
PRICING_PACKING_PER_WORKER=800
PRICING_LOADING_PER_WORKER=600
PRICING_UNLOADING_PER_WORKER=600
# GST remains disabled until applicable tax treatment is confirmed.
PRICING_TAX_STATUS=disabled
# Set PRICING_TAX_RATE only if tax status is explicitly enabled after review.
# PRICING_TAX_RATE=
